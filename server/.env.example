PORT=5000
NODE_ENV=development
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017
MONGO_URI=
MONGO_DB_NAME=ecommerce
PREFER_LOCAL_DB=true
ALLOW_IN_MEMORY_FALLBACK=false
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_secure_long_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_secure_secret
JWT_REFRESH_EXPIRES_IN=30d
REFRESH_COOKIE_MAX_AGE_MS=2592000000
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=change_this_admin_password
